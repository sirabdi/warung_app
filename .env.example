APP_NAME=Warung
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=warung
DB_USERNAME=root
DB_PASSWORD=

# Batas "stok menipis" di laporan
LOW_STOCK_THRESHOLD=5

# Akun pemilik warung yang dibuat oleh `php artisan db:seed`
WARUNG_USER_NAME="Pemilik Warung"
WARUNG_USER_EMAIL=warung@example.com
WARUNG_USER_PASSWORD=rahasia123
# Nama toko #1 (toko milik pemilik aplikasi, langganannya tidak pernah habis)
WARUNG_STORE_NAME=Warung
# Login /admin yang dibuat seeder (hanya APP_ENV=local; di server: php artisan admin:create)
WARUNG_ADMIN_EMAIL=admin@example.com
WARUNG_ADMIN_PASSWORD=rahasia123

# Pembayaran langganan: fake = tombol bayar simulasi di lokal (tanpa akun apa pun);
# xendit = Xendit Invoice. Kunci xnd_development_… (Test Mode) memakai uang bohongan.
# Callback token: Xendit Dashboard → Settings → Webhooks; URL webhook:
# https://<domain>/webhooks/xendit/invoice
# Pengingat & pembersihan akun butuh scheduler: php artisan schedule:work (lokal)
PAYMENT_DRIVER=fake
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email "lupa password". `log` hanya menulis email ke storage/logs/laravel.log.
# Untuk benar-benar mengirim, isi SMTP, contoh Gmail (pakai App Password, bukan
# password akun): MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=akun@gmail.com, MAIL_PASSWORD=<app password 16 huruf>,
# MAIL_FROM_ADDRESS=akun@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Menit tautan ganti password tetap berlaku.
PASSWORD_RESET_EXPIRE=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
